-- Auto Clear Gear Shop
function xDTaraZ.Shop.ClearGearShop()
    if xDTaraZ.Colony.ClaimsInFlight() then return false end
    return xDTaraZ.Util.Action("GearShop", function()
        local now = os.clock()
        if not State.GearShop or (now - State.GearSnapshotTime) > 12 then
            xDTaraZ.Shop.RefreshGearSnapshot()
            task.wait(0.25)
        end

        local gearModel = xDTaraZ.GameLib.Apis.GearShop
        local hasFilter = next(State.Opt.GearFilter) ~= nil
        local boughtCount = 0

        local function shouldBuyItem(itemId, price, stock)
            if stock ~= nil and tonumber(stock) and tonumber(stock) <= 0 then return false end
            if hasFilter and itemId and not State.Opt.GearFilter[tostring(itemId)] then return false end
            local currentGold = xDTaraZ.Data.Snapshot().Gold
            local numPrice = tonumber(price) or 0
            if numPrice > 0 and numPrice > math.max(0, currentGold - State.Opt.KeepGold) then
                return false
            end
            return true
        end

        if type(gearModel) == "table" then
            local stateData = nil
            pcall(function()
                if type(gearModel.GetState) == "function" then
                    stateData = xDTaraZ.GameLib.Call(gearModel.GetState, gearModel)
                elseif type(gearModel.GetSnapshot) == "function" then
                    stateData = xDTaraZ.GameLib.Call(gearModel.GetSnapshot, gearModel)
                elseif type(gearModel.Items) == "table" then
                    stateData = gearModel
                end
            end)

            local itemsList = type(stateData) == "table" and (stateData.Items or stateData.ShopItems or stateData.Stock or stateData.List or stateData)
            if type(itemsList) == "table" then
                for idx, entry in pairs(itemsList) do
                    if type(entry) == "table" then
                        local itemId = entry.ItemId or entry.Id or entry.ProductId or entry.Name or (type(idx) == "string" and idx)
                        local stock = entry.Stock or entry.Remain or entry.Count or entry.Left or 1
                        local price = entry.Price or entry.Cost or entry.Gold or 0
                        local slotIdx = entry.SlotIndex or entry.Index or idx
                        if itemId and shouldBuyItem(itemId, price, stock) then
                            local purchased = false
                            pcall(function()
                                if type(gearModel.PurchaseItem) == "function" then
                                    xDTaraZ.GameLib.Call(gearModel.PurchaseItem, gearModel, itemId)
                                    purchased = true
                                elseif type(gearModel.BuyItem) == "function" then
                                    xDTaraZ.GameLib.Call(gearModel.BuyItem, gearModel, itemId)
                                    purchased = true
                                elseif type(gearModel.Purchase) == "function" then
                                    xDTaraZ.GameLib.Call(gearModel.Purchase, gearModel, itemId)
                                    purchased = true
                                end
                            end)
                            if not purchased then
                                EventRE:FireServer(xDTaraZ.Data.GearShopRequestEvent, {
                                    Action = "Purchase",
                                    ItemId = itemId,
                                    ProductId = itemId,
                                    SlotIndex = slotIdx,
                                    Index = slotIdx,
                                    Count = 1,
                                })
                                EventRE:FireServer(xDTaraZ.Data.GearShopRequestEvent, {
                                    Action = "Buy",
                                    ItemId = itemId,
                                    SlotIndex = slotIdx,
                                    Count = 1,
                                })
                            end
                            boughtCount += 1
                            State.Metrics.GearBought += 1
                            task.wait(0.15)
                        end
                    end
                end
            end
        end

        if boughtCount == 0 and type(State.GearShop) == "table" then
            local snapItems = State.GearShop.Items or State.GearShop.Stock or State.GearShop.Slots or State.GearShop.Catalog or State.GearShop
            if type(snapItems) == "table" then
                for idx, entry in pairs(snapItems) do
                    local itemId = type(entry) == "table" and (entry.ItemId or entry.Id or entry.ProductId or entry.Name) or (type(idx) == "string" and idx)
                    local stock = type(entry) == "table" and (entry.Stock or entry.Remain or entry.Count or 1) or tonumber(entry)
                    local price = type(entry) == "table" and (entry.Price or entry.Cost or 0) or 0
                    local slotIdx = type(entry) == "table" and (entry.SlotIndex or entry.Index) or idx
                    if itemId and shouldBuyItem(itemId, price, stock) then
                        EventRE:FireServer(xDTaraZ.Data.GearShopRequestEvent, {
                            Action = "Purchase",
                            ItemId = itemId,
                            ProductId = itemId,
                            SlotIndex = slotIdx,
                            Index = slotIdx,
                            Count = 1,
                        })
                        EventRE:FireServer(xDTaraZ.Data.GearShopRequestEvent, {
                            Action = "Buy",
                            ItemId = itemId,
                            SlotIndex = slotIdx,
                            Count = 1,
                        })
                        boughtCount += 1
                        State.Metrics.GearBought += 1
                        task.wait(0.15)
                    end
                end
            end
        end

        if boughtCount == 0 then
            for idx, itemId in ipairs(xDTaraZ.Data.GearItemNames) do
                if shouldBuyItem(itemId, 0, 1) then
                    EventRE:FireServer(xDTaraZ.Data.GearShopRequestEvent, {
                        Action = "Purchase",
                        ItemId = itemId,
                        ProductId = itemId,
                        SlotIndex = idx,
                        Count = 1,
                    })
                    boughtCount += 1
                    task.wait(0.1)
                end
            end
        end

        if boughtCount > 0 then
            xDTaraZ.Util.PushStatus("GearShop", string.format("GearShop: bought %d item(s)", boughtCount))
        end
        return boughtCount > 0
    end)
end

