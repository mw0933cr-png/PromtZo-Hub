function xDTaraZ.Teleport.Refresh()
    local points = {}
    local room = xDTaraZ.Colony.Room()
    if room and room.BaseGround then points["My Nest"] = room.BaseGround end
    for _, object in ipairs(workspace:GetChildren()) do
        if object.Name == "GearShop" or object.Name == "PetShop" or object.Name == "StrawberryKingPart" then
            points[object.Name] = object
        end
    end
    local entrances = workspace:FindFirstChild("DungeonEntrances")
    if entrances then
        for _, entry in ipairs(entrances:GetChildren()) do
            local target = entry:IsA("BasePart") and entry or entry:FindFirstChildWhichIsA("BasePart", true)
            if target then points["Dungeon " .. entry.Name] = target end
        end
    end
    local hallCheck = workspace:FindFirstChild("HalloweenCheckIn")
    if hallCheck then points["Halloween: Check-In Door"] = hallCheck end
    local hallDungeon = workspace:FindFirstChild("HalloweenDungeonEntrance")
    if hallDungeon then points["Halloween: Dungeon Portal"] = hallDungeon end
    local treasure = workspace:FindFirstChild("Treasure")
    if treasure then
        local tPart = treasure:FindFirstChild("RootPart") or treasure:FindFirstChildWhichIsA("BasePart", true)
        if tPart then points["Halloween: Pumpkin Chest"] = tPart end
    end
    local nodeFold = workspace:FindFirstChild("NodeFold")
    if nodeFold then
        local spin = nodeFold:FindFirstChild("hallspin")
        if spin then points["Halloween: Spin Wheel"] = spin end
        local witch = nodeFold:FindFirstChild("女巫炼药锅")
        local witchPart = witch and (witch:FindFirstChild("女巫点") or witch:FindFirstChildWhichIsA("BasePart", true))
        if witchPart then points["Halloween: Witch Cauldron"] = witchPart end
        local dayReward = nodeFold:FindFirstChild("actdayreward")
        local dayPart = dayReward and (dayReward:FindFirstChild("actdayreward") or dayReward:FindFirstChildWhichIsA("BasePart", true))
        if dayPart then points["Halloween: Daily Reward"] = dayPart end
    end

    State.TravelPoints = points
    local names = {}
    for name in pairs(points) do names[#names + 1] = name end
    table.sort(names)
    return names
end

