---@param prompt ProximityPrompt?
---@param part BasePart?
function xDTaraZ.Halloween.TriggerPrompt(prompt, part)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    if not fireproximityprompt then return false end
    if xDTaraZ.Halloween.IsInDungeon() then return false end

    local hrp = xDTaraZ.Util.GetHRP()
    local targetPart = part or (prompt.Parent:IsA("BasePart") and prompt.Parent) or prompt.Parent:FindFirstChildWhichIsA("BasePart", true)
    if hrp and targetPart and State.Opt.HalloweenAutoTp then
        local dist = (hrp.Position - targetPart.Position).Magnitude
        local maxDist = (prompt.MaxActivationDistance or 10) + 1.5
        if dist > maxDist then
            local oldCFrame = hrp.CFrame
            if workspace.StreamingEnabled then
                pcall(function() LocalPlayer:RequestStreamAroundAsync(targetPart.Position) end)
            end
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 3.5, 0))
            task.wait(0.25)
            pcall(fireproximityprompt, prompt)
            task.wait(0.2)
            if hrp.Parent and not xDTaraZ.Halloween.IsInDungeon() then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = oldCFrame
            end
            State.Metrics.HalloweenActions += 1
            return true
        end
    end
    pcall(fireproximityprompt, prompt)
    State.Metrics.HalloweenActions += 1
    return true
end

