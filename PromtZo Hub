function xDTaraZ.Halloween.GetSessionId()
    if type(State.DungeonSessionId) == "string" and #State.DungeonSessionId == 36 then
        return State.DungeonSessionId
    end
    local dSess = xDTaraZ.GameLib.Apis.DungeonSession
    if type(dSess) == "table" then
        for _, v in pairs(dSess) do
            if type(v) == "string" and #v == 36 and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
                State.DungeonSessionId = v
                return v
            elseif type(v) == "table" and type(v.SessionId) == "string" then
                State.DungeonSessionId = v.SessionId
                return v.SessionId
            end
        end
    end
    if getgc then
        pcall(function()
            for _, obj in ipairs(getgc(true)) do
                if type(obj) == "table" and rawget(obj, "SessionId") and type(obj.SessionId) == "string" then
                    if #obj.SessionId == 36 then
                        State.DungeonSessionId = obj.SessionId
                        break
                    end
                end
            end
        end)
    end
    return State.DungeonSessionId
end

