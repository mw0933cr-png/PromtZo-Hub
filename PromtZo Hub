                    local track = Instance.new("TextButton")
                    track.Size = UDim2.new(1, -20, 0, 8)
                    track.Position = UDim2.new(0, 10, 0, 30)
                    track.AutoButtonColor = false
                    track.Text = ""
                    track.Parent = row
                    BindTheme(track, "BackgroundColor3", "BgCard")
                    Corner(track, 4)

                    local fill = Instance.new("Frame")
                    fill.Size = UDim2.new(0, 0, 1, 0)
                    fill.BorderSizePixel = 0
                    fill.Parent = track
                    BindTheme(fill, "BackgroundColor3", "Accent")
                    Corner(fill, 4)

                    local SliderObj = { Value = tonumber(info.Default) or minVal }

                    local function RoundNumber(n)
                        local mult = 10 ^ rounding
                        return math.floor(n * mult + 0.5) / mult
                    end

                    function SliderObj:SetValue(v)
                        local clamped = RoundNumber(math.clamp(tonumber(v) or minVal, minVal, maxVal))
                        SliderObj.Value = clamped
                        local alpha = (maxVal > minVal) and ((clamped - minVal) / (maxVal - minVal)) or 0
                        Tween(fill, 0.08, { Size = UDim2.new(alpha, 0, 1, 0) })
                        local fmt = rounding > 0 and ("%." .. tostring(rounding) .. "f%s") or "%.0f%s"
                        valLbl.Text = string.format(fmt, clamped, suffix)
                        if info.Callback then
                            task.spawn(info.Callback, clamped)
                        end
                    end

                    local sliding = false
                    local function UpdateFromInput(input)
                        local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                        SliderObj:SetValue(minVal + (maxVal - minVal) * relX)
                    end

                    track.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            sliding = true
                            UpdateFromInput(inp)
                        end
                    end)
                    table.insert(Lib.UiConns, UserInputService.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            sliding = false
                        end
                    end))
                    table.insert(Lib.UiConns, UserInputService.InputChanged:Connect(function(inp)
                        if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            UpdateFromInput(inp)
                        end
                    end))

                    SliderObj:SetValue(SliderObj.Value)
                    Lib.Options[id] = SliderObj
                    table.insert(Lib.Searchables, { Frame = row, Title = info.Text or id, Desc = "" })
                    return SliderObj
                end

