                if label.Parent then label.Text = pre .. ResolveText(val) end
            end)
        end
    end

    function Lib:SetTheme(name)
        local nextTheme = Themes[name]
        if not nextTheme then return end
        Lib.ThemeName = name
        Lib.Theme = nextTheme
        for _, fn in ipairs(Lib.ThemeListeners) do
            pcall(fn, nextTheme)
        end
    end

    function Lib:SetLanguage(lang)
        Lib.Lang = (lang == "EN") and "EN" or "TH"
        for _, fn in ipairs(Lib.LangListeners) do
            pcall(fn)
        end
    end

    function Lib:OnUnload(fn)
        table.insert(Lib.UnloadCallbacks, fn)
    end

    function Lib:Unload()
        if not Lib.Alive then return end
        Lib.Alive = false
        for _, conn in ipairs(Lib.UiConns) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(Lib.UiConns)
        for _, fn in ipairs(Lib.UnloadCallbacks) do
            pcall(fn)
        end
        if Lib.ScreenGui and Lib.ScreenGui.Parent then
            pcall(function() Lib.ScreenGui:Destroy() end)
        end
    end

    function Lib:Every(interval, fn)
        task.spawn(function()
            while Lib.Alive do
                pcall(fn)
                task.wait(interval or 0.2)
            end
        end)
    end

    function Lib:SaveConfig()
        pcall(function()
            if not writefile then return end
            local folder = Lib.ConfigFolder or "PromtZoHub"
            if isfolder and makefolder and not isfolder(folder) then
                makefolder(folder)
            end
            local data = { Theme = Lib.ThemeName, Lang = Lib.Lang, Options = {} }
            for k, opt in pairs(Lib.Options) do
                if opt.Value ~= nil then
                    data.Options[k] = opt.Value
                end
            end
            writefile(folder .. "/autoload.json", HttpService:JSONEncode(data))
            Lib:Notify("PromtZo Hub", Lib.Lang == "TH" and "บันทึกการตั้งค่าเรียบร้อยแล้ว" or "Configuration saved!", 3, "Success")
        end)
    end

    function Lib:LoadAutoloadConfig()
        pcall(function()
            if not readfile or not isfile then return end
            local path = (Lib.ConfigFolder or "PromtZoHub") .. "/autoload.json"
            if not isfile(path) then return end
            local raw = readfile(path)
            local decoded = HttpService:JSONDecode(raw)
            if type(decoded) ~= "table" then return end
            if decoded.Theme and Themes[decoded.Theme] then Lib:SetTheme(decoded.Theme) end
            if decoded.Lang then Lib:SetLanguage(decoded.Lang) end
            if type(decoded.Options) == "table" then
                for k, v in pairs(decoded.Options) do
                    if Lib.Options[k] and Lib.Options[k].SetValue then
                        pcall(function() Lib.Options[k]:SetValue(v) end)
                    end
                end
            end
        end)
    end

