do
    pcall(function()
        if not hookmetamethod or not getnamecallmethod then return end
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if self == EventRE and (method == "FireServer" or method == "fireServer") then
                local a1, a2, a3 = ...
                if a1 == "ECS_COMMAND" and a2 == "DungeonCommand" and type(a3) == "table" then
                    if type(a3.SessionId) == "string" and a3.SessionId ~= "" then
                        State.DungeonSessionId = a3.SessionId
                    end
                    if type(a3.TransitionId) == "string" and a3.TransitionId ~= "" then
                        State.DungeonTransitionId = a3.TransitionId
                    end
                    if type(a3.CoinId) == "number" then
                        State.DungeonCoinId = a3.CoinId + 1
                    end
                elseif a1 == "SetBackpackHeldEntry" and type(a2) == "table" then
                    if a2.ItemId == "Will-o'-Wisps" and type(a2.Pos) == "number" then
                        State.WispSlotPos = a2.Pos
                    end
                elseif a1 == "HalloweenTreasureRequest" and a2 == "Open" and type(a3) == "number" then
                    State.TreasureChestId = a3
                elseif a1 == "BroomFlightRequest" and type(a2) == "table" and type(a2.RequestId) == "number" then
                    State.BroomRequestId = a2.RequestId + 1
                end
            end
            return oldNamecall(self, ...)
        end)
    end)
end

