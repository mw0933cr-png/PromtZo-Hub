---@param label string
function PromtZoBanner.Step(label)
    local now = os.clock()
    PromtZoBanner.Done = math.min(PromtZoBanner.Done + 1, PromtZoBanner.Total)
    local filled = math.floor(PromtZoBanner.Done / PromtZoBanner.Total * 20 + 0.5)
    PromtZoBanner.Print(string.format("[PromtZo Hub] [%s] %3d%%  %-24s +%dms",
        string.rep("#", filled) .. string.rep(".", 20 - filled),
        math.floor(PromtZoBanner.Done / PromtZoBanner.Total * 100), label, math.floor((now - PromtZoBanner.Last) * 1000)))
    PromtZoBanner.Last = now
end

